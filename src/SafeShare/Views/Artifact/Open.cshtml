@model OpenArtifactViewModel
@{
    ViewData["Title"] = "Shared page";
    ViewData["Guest"] = true;
}
@* Recipients (often customers) see only what they need to open the page: no navigation, no explanations. *@
<section class="panel guest-card" id="artifact-open" data-id="@Model.Id" data-salt="@Model.Salt">
    <h1>You have received a shared page</h1>
    <p class="muted">Enter the password you were given to open it.</p>

    <form id="artifact-unlock">
        <label class="field">
            Password
            <span class="input-row">
                <input id="artifact-open-password" type="password" class="input mono" autocomplete="off" spellcheck="false" required autofocus />
                <partial name="_RevealToggle" model="@("#artifact-open-password")" />
            </span>
        </label>
        <div class="error" id="artifact-open-error" hidden></div>
        <button type="submit" class="btn primary" id="artifact-open-btn">Open</button>
    </form>

    <p class="muted small">This link expires <partial name="_Expiry" model="(DateTime?)Model.ExpiresUtc" />.</p>
</section>

<div class="artifact-viewer" id="artifact-viewer" hidden>
    <div class="artifact-bar">
        <span class="artifact-title" id="artifact-viewer-title"></span>
        <span class="artifact-bar-end">
            <span class="muted small">Available <partial name="_Expiry" model="(DateTime?)Model.ExpiresUtc" /></span>
            <button type="button" class="btn" id="artifact-fullscreen">Full screen</button>
        </span>
    </div>
    @* Sandboxed without allow-same-origin: the artifact runs on an opaque origin, isolated from this app. *@
    <iframe id="artifact-frame" title="Shared page" referrerpolicy="no-referrer" allow="fullscreen"
            sandbox="allow-scripts allow-forms allow-modals allow-popups allow-popups-to-escape-sandbox allow-downloads"></iframe>
</div>

@section Scripts {
    <script src="~/js/artifact.js" asp-append-version="true"></script>
}
