@model ManageViewModel
@{
    ViewData["Title"] = "Manage secret";
}
<section class="panel narrow">
    @if (Model.Secret is null)
    {
        <h1>Secret is gone</h1>
        <p class="muted">It has been viewed, has expired, or was already destroyed.</p>
        <a class="btn" href="/share">Share a secret</a>
    }
    else
    {
        <h1>Secret not read yet</h1>
        <p>
            Created <time datetime="@Model.Secret.CreatedUtc.ToString("O")Z" data-relative>@Model.Secret.CreatedUtc.ToString("yyyy-MM-dd HH:mm") UTC</time>,
            auto-burns <partial name="_Expiry" model="Model.Secret.ExpiresUtc" />.
            @if (Model.Secret.FailedAttempts > 0)
            {
                <br /><strong>@Model.Secret.FailedAttempts wrong key or passphrase attempt(s) so far.</strong>
            }
        </p>
        <form method="post" asp-antiforgery="true" action="/s/@Model.Id/manage/@Model.Token">
            <button type="submit" class="btn danger">Destroy secret now</button>
        </form>
    }
</section>

@section Explain {
    <h2>Managing your secret</h2>
    <p>This private page is for the person who created the secret. It shows whether the secret is still waiting to be read.</p>
    <ul>
        <li><strong>Destroy</strong> deletes it immediately. Use it if you sent the link to the wrong person or no longer need it.</li>
        <li><strong>Wrong attempts</strong> mean someone tried a wrong key or passphrase. After 5, the secret is destroyed automatically.</li>
        <li>Once the secret is read, expires or is destroyed, this page shows it as gone. Nothing about its content is kept.</li>
    </ul>
}
