@model OpenViewModel
@{
    ViewData["Title"] = "You received a secret";
}
<section class="panel narrow" id="reveal"
         data-id="@Model.Id" data-salt="@Model.Salt" data-passphrase="@(Model.HasPassphrase ? "1" : "0")">
    <div id="reveal-prompt">
        <h1>You received a secret</h1>
        <p>It can be viewed <strong>only once</strong>. Auto-burns <partial name="_Expiry" model="Model.ExpiresUtc" />.</p>

        <form id="reveal-form">
            @* Shown only when the link arrived without the key, i.e. the sender sent the key through another channel. *@
            <label class="field" id="key-field" hidden>
                Decryption key
                <input id="reveal-key" class="input mono" autocomplete="off" spellcheck="false"
                       placeholder="Paste the key you received separately" />
            </label>
            @if (Model.HasPassphrase)
            {
                <label class="field">
                    Passphrase
                    <input id="reveal-passphrase" type="password" class="input" autocomplete="off" required autofocus />
                </label>
            }
            <div class="error" id="reveal-error" hidden></div>
            <button type="submit" class="btn primary" id="reveal-btn">Reveal secret</button>
        </form>
    </div>

    <div id="reveal-result" hidden>
        <h1>Your secret</h1>
        <div class="flash warn">Deleted from the server. Copy it now; it can't be opened again.</div>
        <textarea id="revealed-text" class="editor revealed" readonly spellcheck="false" aria-label="Secret"></textarea>
        <div class="toolbar">
            <button type="button" class="btn primary" data-copy="#revealed-text">Copy</button>
            <a class="btn" href="/">Share a secret</a>
        </div>
    </div>
</section>

@section Explain {
    <h2>Opening a secret</h2>
    <ol>
        <li>When you click <em>Reveal</em>, your browser fetches the encrypted secret and decrypts it locally. The server never sees the content or the key.</li>
        <li>The server deletes the secret in the same step, so this link won't work again, for you or anyone else.</li>
    </ol>

    <h3>Key and passphrase</h3>
    <ul>
        <li>If the link has no key, the sender has sent it separately (e.g. by chat). Paste it into the key field.</li>
        <li>If there is a passphrase field, the sender will have told you the passphrase.</li>
        <li>After 5 wrong attempts the secret is destroyed.</li>
    </ul>

    <h3>If the secret is gone</h3>
    <p>It may have expired, or someone opened it before you. Tell the sender, especially if you didn't open it yourself.</p>
}

@section Scripts {
    <script src="~/js/share.js" asp-append-version="true"></script>
}
