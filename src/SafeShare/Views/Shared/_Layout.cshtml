@{
    var siteName = SiteOptions.Value.SiteName;
    var title = ViewData["Title"] as string;
    var path = Context.Request.Path.Value ?? "/";
    string Current(string href) => (href == "/" ? path == "/" : path.StartsWith(href)) ? "page" : "false";
}
<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151d1f" media="(prefers-color-scheme: dark)" />
    <title>@(title is null ? siteName : $"{title} – {siteName}")</title>
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="~/fonts/inter-latin-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="topbar" role="banner">
        <div class="wrap topbar-inner">
            <a class="brand" href="/" aria-label="@siteName – home">
                <partial name="_Logo" />
                <span class="brand-name">@siteName</span>
            </a>
            <div class="header-end">
                <nav aria-label="Main">
                    <a href="/" aria-current="@Current("/")">Request a secret</a>
                    <a href="/share" aria-current="@Current("/share")">Share a secret</a>
                    <a href="/requests" aria-current="@Current("/requests")">My requests</a>
                    <a href="/about" aria-current="@Current("/about")">How it works</a>
                </nav>
                <div class="theme-switch" role="group" aria-label="Colour theme">
                    <button type="button" data-theme-choice="light" aria-pressed="true" aria-label="Light theme" title="Light theme">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
                    </button>
                    <button type="button" data-theme-choice="dark" aria-pressed="false" aria-label="Dark theme" title="Dark theme">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
                    </button>
                    <button type="button" data-theme-choice="auto" aria-pressed="false" aria-label="Automatic theme (follow system setting)" title="Follow system setting">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/></svg>
                    </button>
                </div>
            </div>
        </div>
    </header>

    <main class="wrap main" id="main">
        @if (TempData["flash"] is string flash)
        {
            <div class="flash">@flash</div>
        }
        <noscript><div class="flash warn">JavaScript is required: secrets are encrypted and decrypted in your browser.</div></noscript>
        <div class="flash warn" id="insecure-context" hidden>
            Your browser blocks encryption on this page because it isn't served over HTTPS.
            Ask your administrator to put @siteName behind HTTPS.
        </div>
        @Html.AntiForgeryToken()
        @if (IsSectionDefined("Explain"))
        {
            @* Two columns: the left has only what is needed to act, the right explains the page for first-time users. *@
            <div class="split">
                <div class="split-main">@RenderBody()</div>
                <aside class="explain" aria-label="How this works">
                    <p class="eyebrow">How this works</p>
                    @RenderSection("Explain")
                </aside>
            </div>
        }
        else
        {
            @RenderBody()
        }
    </main>

    <footer class="footer">
        <div class="wrap footer-inner">
            <partial name="_Logo" />
            <span>@siteName · end-to-end encrypted one-time secrets</span>
        </div>
    </footer>

    <script src="~/js/common.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
