{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "SafeShare": {
    "SiteName": "SafeShare",
    "DataDirectory": "App_Data",
    "MaxSecretSizeKb": 64,
    "MaxFailedAttempts": 5,
    "AllowNoExpiry": true,
    "DefaultLifetimeMinutes": 1440,
    "MaxLifetimeMinutes": 43200,
    "CleanupIntervalMinutes": 1
  }
}
